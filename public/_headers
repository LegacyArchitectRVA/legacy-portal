# Security headers for Legacy Architect RVA client portal
# Served by Cloudflare Pages from dist/ after Vite build (copied from public/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://legacyarchitectrva.com https://usable-hornet-255.convex.cloud; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com; connect-src 'self' https://usable-hornet-255.convex.cloud wss://usable-hornet-255.convex.cloud https://cloudflareinsights.com; frame-src https://cal.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html has no content hash in its filename (it's what points at the
# hashed asset URLs above), so if it's ever served stale, the browser can
# keep loading an old bundle indefinitely even after a correct new deploy.
# Force it to always revalidate with the server instead of trusting any
# cached copy, so a fresh deploy is guaranteed to take effect on next load.
/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate
